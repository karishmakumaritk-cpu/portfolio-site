  right: -20px;
  top: 50%;
  transform: translateY(-50%);
  width: 140px;
  height: 140px;
  border-radius: 50%;
  border: 1px dashed rgba(180, 154, 103, 0.3);
  animation: radarRotate 20s linear infinite;
  pointer-events: none;
}

@keyframes radarRotate {
  from { transform: translateY(-50%) rotate(0deg); }
  to { transform: translateY(-50%) rotate(360deg); }
}

.sys-core-label {
  font-family: var(--font-ui);
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 0.25rem;
}

.sys-core-title {
  font-family: var(--font-heading);
  font-size: 1.15rem;
  font-weight: 700;
  color: #FFFFFF;
}

.sys-core-status {
  font-family: var(--font-ui);
  font-size: 0.68rem;
  color: #A5A29A;
  display: flex;
  align-items: center;
  gap: 0.4rem;
}

/* Individual Node Buttons */
.sys-interactive-node {
  background: var(--surface2);
  border: 1px solid var(--border2);
  border-radius: 10px;
  padding: 1.2rem 1.25rem;
  text-align: left;
  cursor: pointer;
  transition: all 0.25s var(--ease-motion);
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 110px;
}

.sys-interactive-node:hover {
  transform: translateY(-3px);
  border-color: var(--terracotta);
  background: #FFFFFF;
  box-shadow: 0 10px 24px rgba(182, 93, 70, 0.08);
}

.sys-interactive-node.active-node {
  border-color: var(--terracotta);
  background: #FFFFFF;
  box-shadow: 0 10px 28px rgba(182, 93, 70, 0.12);
}

.sys-interactive-node.active-node::after {
  content: '';
  position: absolute;
  top: -1px;
  left: 0;
  right: 0;
  height: 3px;
  background: var(--terracotta);
  border-radius: 10px 10px 0 0;
}

.node-top-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 0.5rem;
}

.node-code {
  font-family: var(--font-ui);
  font-size: 0.65rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  color: var(--terracotta);
}

.node-price {
  font-family: var(--font-ui);
  font-size: 0.72rem;
  font-weight: 700;
  color: var(--gold-dark);
}

.node-title {
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 0.95rem;
  color: var(--charcoal);
  line-height: 1.25;
}

.node-tagline {
  font-size: 0.76rem;
  color: var(--muted);
  margin-top: 0.35rem;
  line-height: 1.4;
}

/* Live Telemetry Inspector Terminal */
.sys-telemetry-panel {
  background: #1B1917;
  color: #ECE8DF;
  border-radius: 16px;
  padding: 2.2rem 2.2rem;
  border: 1px solid rgba(180, 154, 103, 0.2);
  box-shadow: 0 20px 50px rgba(27, 25, 23, 0.25);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  position: relative;
  overflow: hidden;
}

.telemetry-top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 1rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  margin-bottom: 1.5rem;
}

.telemetry-label {
  font-family: var(--font-ui);
  font-size: 0.65rem;
  font-weight: 800;
  letter-spacing: 0.14em;
  color: var(--gold);
  display: flex;
  align-items: center;
  gap: 0.5rem;
  text-transform: uppercase;
}

.telemetry-status-pill {
  font-family: var(--font-ui);
  font-size: 0.62rem;
  font-weight: 700;
  color: #55DC84;
  background: rgba(85, 220, 132, 0.12);
  padding: 0.25rem 0.6rem;
  border-radius: 999px;
  border: 1px solid rgba(85, 220, 132, 0.25);
}

.telemetry-node-title {
  font-family: var(--font-display);
  font-size: 1.6rem;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: -0.02em;
  margin-bottom: 0.6rem;
}

.telemetry-node-desc {
  font-size: 0.92rem;
  color: #B5B0A6;
  line-height: 1.65;
  margin-bottom: 1.5rem;
}

/* 5 Precision Strategic Answers */
.telemetry-specs-list {
  display: flex;
  flex-direction: column;
  gap: 0.95rem;
  margin-bottom: 2rem;
}

.telemetry-spec-item {
  display: grid;
  grid-template-columns: 120px 1fr;
  gap: 1rem;
  font-size: 0.82rem;
  line-height: 1.5;
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  padding-bottom: 0.65rem;
}

.spec-key {
  font-family: var(--font-ui);
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--gold);
}

.spec-val {
  color: #E2DFD8;
}

.telemetry-bottom-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 1.2rem;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  flex-wrap: wrap;
  gap: 1rem;
}

.telemetry-price-box {
  display: flex;
  flex-direction: column;
}

.telemetry-price-label {
  font-family: var(--font-ui);
  font-size: 0.65rem;
  color: #8C887E;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.telemetry-price-val {
  font-family: var(--font-heading);
  font-size: 1.35rem;
  font-weight: 700;
  color: #FFFFFF;
}

.telemetry-btn-action {
  background: var(--terracotta);
  color: #FFFFFF;
  border: none;
  padding: 0.8rem 1.4rem;
  border-radius: 8px;
  font-family: var(--font-ui);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  transition: background-color 0.2s ease, transform 0.2s ease;
}

.telemetry-btn-action:hover {
  background: var(--terracotta-dark);
  transform: translateY(-2px);
  color: #FFFFFF;
}

@media (max-width: 960px) {
  .systems-map-wrapper {
    grid-template-columns: 1fr;
  }
}

/* ==========================================================================
   DISCOVERABILITY LAB: WORD FLIPPER & TECHNICAL LAB ACCENTS
   ========================================================================== */
.lab-word-flipper-box {
  display: inline-flex;
  align-items: center;
  gap: 0.65rem;
  background: rgba(182, 93, 70, 0.08);
  border: 1px solid rgba(182, 93, 70, 0.25);
  border-radius: 999px;
  padding: 0.4rem 1.2rem;
  margin-bottom: 1.4rem;
}

.flipper-prefix {
  font-family: var(--font-ui);
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--charcoal);
}

.flipper-words-viewport {
  height: 1.3rem;
  overflow: hidden;
  position: relative;
  display: inline-block;
  min-width: 130px;
}

.flipper-word {
  display: block;
  font-family: var(--font-ui);
  font-size: 0.74rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--terracotta);
  line-height: 1.3rem;
  transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.5s ease;
}

/* ==========================================================================
   ABOUT ARCHITECT: MANIFESTO & REAL OPERATOR PROFILE
   ========================================================================== */
.architect-profile-section {
  background: #F8F5EE;
  border-bottom: 1px solid var(--border);
  position: relative;
  overflow: hidden;
}

.architect-manifesto-quote {
  font-family: var(--font-display);
  font-size: clamp(1.8rem, 3.2vw, 2.8rem);
  font-weight: 700;
  line-height: 1.22;
  color: var(--charcoal);
  letter-spacing: -0.025em;
  margin-bottom: 2rem;
  max-width: 880px;
}

.manifesto-highlight {
  color: var(--terracotta);
  font-style: italic;
  font-weight: 400;
}

/* ==========================================================================
   CONVERSION BRIDGE & DIGITAL PRODUCTS SHELF
   ========================================================================== */
.conversion-bridge-section {
  background: #F6F1E7;
  border-bottom: 1px solid var(--border);
  padding: 5.5rem 2.5rem;
}

.bridge-pathways-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.8rem;
  max-width: 1240px;
  margin: 3rem auto 0;
}

.bridge-path-card {
  background: #FFFFFF;
  border: 1px solid var(--border2);
  border-radius: 14px;
  padding: 2.2rem 1.8rem;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  transition: transform 0.3s var(--ease-motion), box-shadow 0.3s ease, border-color 0.3s ease;
  position: relative;
  overflow: hidden;
}

.bridge-path-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 16px 36px rgba(27, 25, 23, 0.08);
  border-color: var(--terracotta);
}

.bridge-path-card.featured-path {
  border-color: var(--terracotta);
  background: linear-gradient(180deg, #FFFFFF 0%, #FDF9F5 100%);
}

.bridge-path-card.featured-path::before {
  content: 'RECOMMENDED';
  position: absolute;
  top: 1rem;
  right: 1.2rem;
  font-family: var(--font-ui);
  font-size: 0.6rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  color: var(--terracotta);
  background: rgba(182, 93, 70, 0.1);
  padding: 0.2rem 0.55rem;
  border-radius: 999px;
}

.path-num {
  font-family: var(--font-ui);
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.14em;
  color: var(--gold-dark);
  margin-bottom: 0.8rem;
}

.path-title {
  font-family: var(--font-heading);
  font-size: 1.35rem;
  font-weight: 700;
  color: var(--charcoal);
  margin-bottom: 0.75rem;
  line-height: 1.2;
}

.path-desc {
  font-size: 0.88rem;
  color: var(--muted);
  line-height: 1.6;
  margin-bottom: 1.6rem;
}

.path-link {
  font-family: var(--font-ui);
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--terracotta);
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  transition: gap 0.2s ease;
}

.path-link:hover {
  gap: 0.7rem;
}

/* Digital Products & Ready Templates Shelf */
.digital-products-shelf {
  max-width: 1240px;
  margin: 4.5rem auto 0;
  padding-top: 3.5rem;
  border-top: 1px solid var(--border);
}

.shelf-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 2rem;
  flex-wrap: wrap;
  gap: 1rem;
}

.shelf-title {
  font-family: var(--font-heading);
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--charcoal);
}

.shelf-sub {
  font-size: 0.88rem;
  color: var(--muted);
}

.products-grid-scroll {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
}

.product-item-card {
  background: #FFFFFF;
  border: 1px solid var(--border2);
  border-radius: 12px;
  overflow: hidden;
  transition: transform 0.25s var(--ease-motion), box-shadow 0.25s ease;
  display: flex;
  flex-direction: column;
}

.product-item-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 14px 30px rgba(27, 25, 23, 0.08);
}

.product-item-thumb {
  height: 160px;
  width: 100%;
  object-fit: cover;
}

.product-item-body {
  padding: 1.25rem 1.4rem;
  display: flex;
  flex-direction: column;
  flex-grow: 1;
  justify-content: space-between;
}

.product-item-tag {
  font-family: var(--font-ui);
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--terracotta);
  margin-bottom: 0.4rem;
}

.product-item-name {
  font-family: var(--font-heading);
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--charcoal);
  margin-bottom: 0.4rem;
}

.product-item-desc {
  font-size: 0.8rem;
  color: var(--muted);
  line-height: 1.5;
  margin-bottom: 1.2rem;
}

.product-item-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 0.8rem;
  border-top: 1px solid var(--border);
}

.product-item-price {
  font-family: var(--font-ui);
  font-size: 0.78rem;
  font-weight: 700;
  color: var(--charcoal);
}

.product-item-cta {
  font-family: var(--font-ui);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--terracotta);
  text-decoration: none;
}

@media (max-width: 900px) {
  .bridge-pathways-grid {
    grid-template-columns: 1fr;
  }
  .products-grid-scroll {
    grid-template-columns: 1fr;
  }
}

/* ==========================================================================
   CINEMATIC CONTACT CHAPTER & SMART INQUIRY FORM
   ========================================================================== */
.contact-cinematic-chapter {
  background: #141312;
  color: #F8F5EE;
  padding: 6.5rem 2.5rem;
  position: relative;
  overflow: hidden;
}

.contact-cinematic-bg {
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: 0.35;
  background-image: 
    radial-gradient(circle at 80% 20%, rgba(180, 154, 103, 0.15) 0%, transparent 50%),
    radial-gradient(circle at 20% 80%, rgba(182, 93, 70, 0.12) 0%, transparent 60%);
}

.contact-chapter-inner {
  max-width: 1240px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1.15fr;
  gap: 4.5rem;
  position: relative;
  z-index: 1;
}

.contact-left-col {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.contact-chapter-headline {
  font-family: var(--font-display);
  font-size: clamp(2.4rem, 4vw, 3.8rem);
  font-weight: 700;
  line-height: 1.12;
  color: #FFFFFF;
  letter-spacing: -0.025em;
  margin-bottom: 1.5rem;
}

.contact-chapter-sub {
  font-size: 1.05rem;
  color: #B2ADA2;
  line-height: 1.75;
  margin-bottom: 2.5rem;
  max-width: 480px;
}

.contact-direct-channels {
  display: flex;
  flex-direction: column;
  gap: 1.2rem;
  margin-bottom: 3rem;
}

.direct-channel-item {
  display: flex;
  align-items: center;
  gap: 1rem;
  text-decoration: none;
  color: #ECE7DD;
  transition: color 0.2s ease;
}

.direct-channel-item:hover {
  color: var(--gold);
}

.channel-icon-box {
  width: 42px;
  height: 42px;
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--gold);
}

.channel-meta-title {
  font-family: var(--font-ui);
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #8C877D;
}

.channel-meta-val {
  font-family: var(--font-heading);
  font-size: 0.95rem;
  font-weight: 600;
  color: #FFFFFF;
}

/* Smart Project Inquiry Form */
.smart-inquiry-box {
  background: rgba(32, 30, 28, 0.85);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(180, 154, 103, 0.25);
  border-radius: 18px;
  padding: 2.8rem 2.5rem;
  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.4);
}

.inquiry-form-title {
  font-family: var(--font-heading);
  font-size: 1.35rem;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 0.4rem;
}

.inquiry-form-sub {
  font-size: 0.84rem;
  color: #9C968B;
  margin-bottom: 1.8rem;
}

.inquiry-fields-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.2rem;
  margin-bottom: 1.2rem;
}

.inquiry-fields-grid.full-width {
  grid-template-columns: 1fr;
}

.inquiry-field-group {
  display: flex;
  flex-direction: column;
}

.inquiry-label {
  font-family: var(--font-ui);
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #C8C3B8;
  margin-bottom: 0.45rem;
}

.inquiry-input, .inquiry-select, .inquiry-textarea {
  background: rgba(18, 17, 16, 0.7);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 8px;
  padding: 0.75rem 1rem;
  color: #FFFFFF;
  font-family: var(--font-body);
  font-size: 0.88rem;
  outline: none;
  transition: border-color 0.2s ease, background 0.2s ease;
}

.inquiry-input:focus, .inquiry-select:focus, .inquiry-textarea:focus {
  border-color: var(--terracotta);
  background: rgba(18, 17, 16, 0.95);
}

.inquiry-textarea {
  resize: vertical;
  min-height: 90px;
}

.inquiry-submit-btn {
  background: var(--terracotta);
  color: #FFFFFF;
  border: none;
  border-radius: 8px;
  padding: 0.95rem 1.8rem;
  font-family: var(--font-ui);
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  cursor: pointer;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.6rem;
  transition: background-color 0.2s ease, transform 0.2s ease;
  margin-top: 1rem;
}

.inquiry-submit-btn:hover {
  background: var(--terracotta-dark);
  transform: translateY(-2px);
}

.inquiry-guarantee-note {
  font-size: 0.72rem;
  color: #8C867B;
  text-align: center;
  margin-top: 0.9rem;
}

@media (max-width: 900px) {
  .contact-chapter-inner {
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  .inquiry-fields-grid {
    grid-template-columns: 1fr;
  }
}

/* ==========================================================================
   AMBIENT WATERMARK FOOTER & CONTACT CHOREOGRAPHY
   ========================================================================== */
#global-footer,
footer {
  background: #030303;
  color: var(--text-secondary);
  position: relative;
  overflow: hidden;
  border-top: 1px solid var(--border);
}

.footer-gold-sweep-line {
  position: absolute;
  top: 0;
  left: 0;
  width: 0%;
  height: 2px;
  background: linear-gradient(90deg, transparent 0%, var(--gold-bright) 45%, var(--gold) 75%, transparent 100%);
  pointer-events: none;
  z-index: 10;
}

#global-footer.in-view .footer-gold-sweep-line {
  animation: footerSweepLaser 1.5s cubic-bezier(0.16, 1, 0.3, 1) 0.2s forwards;
}

@keyframes footerSweepLaser {
  0% { width: 0%; opacity: 0; }
  50% { width: 100%; opacity: 1; }
  100% { width: 100%; opacity: 0.35; }
}

.footer-bg-drifting-words {
  position: absolute;
  top: 18%;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-around;
  font-family: var(--font-heading);
  font-size: clamp(3rem, 7vw, 6.5rem);
  font-weight: 800;
  letter-spacing: 0.04em;
  color: rgba(201, 162, 75, 0.032);
  user-select: none;
  pointer-events: none;
  z-index: 0;
  will-change: transform;
}

.drift-word {
  display: inline-block;
}

.drift-sep {
  color: rgba(201, 162, 75, 0.018);
}

.footer-watermark-ambient {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  font-family: var(--font-heading);
  font-size: clamp(4rem, 12vw, 14rem);
  font-weight: 900;
  color: rgba(201, 162, 75, 0.018);
  pointer-events: none;
  user-select: none;
  text-align: center;
  white-space: nowrap;
  letter-spacing: 0.04em;
  line-height: 0.8;
  z-index: 0;
}

/* ==========================================================================
   SCROLL PROGRESS INDICATOR
   ========================================================================== */
#scroll-progress {
  position: fixed;
  top: 0;
  left: 0;
  height: 2px;
  width: 0%;
  background: linear-gradient(90deg, var(--gold-bright) 0%, var(--gold) 50%, var(--gold-muted) 100%);
  box-shadow: 0 0 10px rgba(201, 162, 75, 0.4);
  z-index: 999999;
  transition: width 0.08s ease-out;
  pointer-events: none;
}

/* ==========================================================================
   MINI VISUAL STICKER SYSTEM (EDITORIAL DIGITAL STICKERS & OBJECTS)
   ========================================================================== */
.sticker-element {
  position: absolute;
  z-index: 4;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.35rem 0.75rem;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid var(--border2);
  border-radius: 8px;
  box-shadow: 0 8px 24px rgba(27, 25, 23, 0.06);
  font-family: var(--font-ui);
  font-size: 0.64rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--charcoal);
  user-select: none;
  pointer-events: auto;
  transition: transform 0.25s var(--ease-motion), border-color 0.2s ease, box-shadow 0.25s ease;
}

.sticker-element:hover {
  transform: translateY(-3px) scale(1.03);
  border-color: var(--terracotta);
  box-shadow: 0 12px 28px rgba(182, 93, 70, 0.12);
