/* =========================================================
   GLOBAL BACKGROUND — CINEMATIC, NOT CYBERPUNK
   ========================================================= */

body::before {
  display: none;
}

body::after {
  content: '';
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  opacity: .55;
  background:
    radial-gradient(circle at 72% 18%, rgba(201,162,75,.035), transparent 26%),
    radial-gradient(circle at 18% 72%, rgba(255,255,255,.018), transparent 30%);
}

.page-view-container {
  position: relative;
  z-index: 1;
}

/* Subtle technical grid only where explicitly requested */
.section-technical-grid {
  position: relative;
  isolation: isolate;
}

.section-technical-grid::before {
  content: '';
  position: absolute;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  opacity: .28;
  background-image:
    linear-gradient(rgba(201,162,75,.025) 1px, transparent 1px),
    linear-gradient(90deg, rgba(201,162,75,.025) 1px, transparent 1px);
  background-size: 72px 72px;
}

/* Hero atmospheric lighting */
.hero-editorial::after {
  content: '';
  position: absolute;
  width: min(70vw, 900px);
  height: min(70vw, 900px);
  left: 52%;
  top: 48%;
  transform: translate(-50%, -50%);
  pointer-events: none;
  z-index: 0;
  border-radius: 50%;
  background: radial-gradient(
    circle,
    rgba(201,162,75,.055) 0%,
    rgba(201,162,75,.018) 35%,
    transparent 70%
  );
  filter: blur(70px);
  animation: heroAmbientBreath 9s ease-in-out infinite alternate;
}

@keyframes heroAmbientBreath {
  from {
    transform: translate(-50%, -50%) scale(.94);
    opacity: .55;
  }
  to {
    transform: translate(-50%, -50%) scale(1.06);
    opacity: 1;
  }
}

@media (prefers-reduced-motion: reduce) {
  .hero-editorial::after {
    animation: none;
  }
}

/* =========================================================
   CHARACTER — CINEMATIC POINTER REVEAL
   Professional = base / Developer = living interaction
   ========================================================= */

.interactive-character-stage {
  cursor: none;
  overflow: visible;
}

.interactive-character-stage .base-character-layer {
  z-index: 1;
}

.interactive-character-stage .overlay-character-layer {
  z-index: 10;
  opacity: 1;
  filter: brightness(1.04) contrast(1.06);
  -webkit-mask-image: radial-gradient(
    circle var(--mask-radius, 0px) at var(--mask-x, 50%) var(--mask-y, 50%),
    rgba(0,0,0,1) 0%,
    rgba(0,0,0,.92) 34%,
    rgba(0,0,0,.52) 62%,
    rgba(0,0,0,0) 100%
  );
  mask-image: radial-gradient(
    circle var(--mask-radius, 0px) at var(--mask-x, 50%) var(--mask-y, 50%),
    rgba(0,0,0,1) 0%,
    rgba(0,0,0,.92) 34%,
    rgba(0,0,0,.52) 62%,
    rgba(0,0,0,0) 100%
  );
}

.interactive-character-stage::after {
  content: 'REVEAL';
  position: absolute;
  left: var(--cursor-x, 50%);
  top: var(--cursor-y, 50%);
  z-index: 40;
  transform: translate(-50%, -50%);
  padding: 7px 9px;
  border: 1px solid rgba(201,162,75,.42);
  background: rgba(3,3,3,.82);
  color: var(--gold);
  font-family: var(--font-mono);
  font-size: 8px;
  font-weight: 700;
  letter-spacing: .16em;
  pointer-events: none;
  opacity: 0;
  transition: opacity 180ms ease;
  backdrop-filter: blur(8px);
}

.interactive-character-stage:hover::after {
  opacity: 1;
}

.interactive-character-stage .character-reveal-hint {
  display: none;
}

@media (hover: none), (pointer: coarse) {
  .interactive-character-stage {
    cursor: auto;
  }

  .interactive-character-stage::after {
    display: none;
  }
}

/* =========================================================
   HERO — CINEMATIC LIGHT MOVEMENT
   ========================================================= */

.hero-editorial .hero-living-bg {
  overflow: hidden;
}

.hero-editorial .hero-living-bg::before {
  content: '';
  position: absolute;
  width: 42vw;
  height: 42vw;
  min-width: 360px;
  min-height: 360px;
  max-width: 680px;
  max-height: 680px;
  left: 58%;
  top: 50%;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: radial-gradient(
    circle,
    rgba(201,162,75,.065) 0%,
    rgba(201,162,75,.025) 28%,
    transparent 68%
  );
  filter: blur(35px);
  animation: heroLightDrift 12s cubic-bezier(.45,0,.25,1) infinite alternate;
}

.hero-editorial .hero-living-bg::after {
  content: '';
  position: absolute;
  width: 1px;
  height: 72%;
  top: 14%;
  left: 67%;
  background: linear-gradient(
    to bottom,
    transparent,
    rgba(201,162,75,.10),
    transparent
  );
  opacity: .55;
  transform: rotate(18deg);
  transform-origin: center;
  animation: heroLightSweep 10s ease-in-out infinite alternate;
}

@keyframes heroLightDrift {
  0% {
    transform: translate(-56%, -48%) scale(.92);
    opacity: .55;
  }
  50% {
    transform: translate(-44%, -52%) scale(1);
    opacity: .8;
  }
  100% {
    transform: translate(-50%, -46%) scale(1.08);
    opacity: .62;
  }
}

@keyframes heroLightSweep {
  0% {
    transform: translateX(-18px) rotate(18deg);
    opacity: .18;
  }
  50% {
    opacity: .55;
  }
  100% {
    transform: translateX(22px) rotate(18deg);
    opacity: .22;
  }
}

@media (prefers-reduced-motion: reduce) {
  .hero-editorial .hero-living-bg::before,
