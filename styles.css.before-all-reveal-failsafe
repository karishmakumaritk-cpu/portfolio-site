/* ==========================================================================
   INTERACTIVE CHARACTER REVEAL & PERSISTENT GUIDE STYLING
   ========================================================================== */
.interactive-character-stage {
  position: relative;
  cursor: crosshair;
}

.base-character-layer {
  position: absolute;
  inset: 0;
  z-index: 1;
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center bottom;
  display: block;
}

.overlay-character-layer {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center bottom;
  opacity: 1;
  z-index: 10;
  pointer-events: none;
  transition: none;
  filter: brightness(1.08) contrast(1.1);
  -webkit-mask-image: radial-gradient(
    circle var(--mask-radius, 150px) at var(--mask-x, 50%) var(--mask-y, 50%),
    rgba(0,0,0,1) 0%,
    rgba(0,0,0,0.85) 40%,
    rgba(0,0,0,0) 100%
  );
  mask-image: radial-gradient(
    circle var(--mask-radius, 150px) at var(--mask-x, 50%) var(--mask-y, 50%),
    rgba(0,0,0,1) 0%,
    rgba(0,0,0,0.85) 40%,
    rgba(0,0,0,0) 100%
  );
}

.state-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #10b981;
}

.state-dot.pulse {
  animation: pulseDot 2s infinite ease-in-out;
}

