}

.pillar-num {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  color: var(--gold-champagne);
  font-weight: 700;
  display: block;
  margin-bottom: 0.2rem;
}

.pillar-name {
  font-family: var(--font-mono);
  font-size: 0.95rem;
  font-weight: 700;
  color: #FFF;
  display: block;
  margin-bottom: 0.3rem;
}

.pillar-desc {
  font-family: var(--font-body);
  font-size: 0.82rem;
  color: var(--text-secondary);
}

.about-ctas-row {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
}

/* WHAT I BUILD Posters */
.what-i-build-posters-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
  gap: 1.4rem;
  margin-top: 2rem;
}

.build-poster-card {
  background: var(--surface);
  border: 1px solid rgba(255, 255, 255, 0.07);
  border-radius: 12px;
  padding: 1.8rem 1.5rem;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 280px;
  cursor: pointer;
  transition: all 0.35s var(--ease-motion);
  position: relative;
  overflow: hidden;
}

.build-poster-card:hover {
  background: var(--surface-hover);
  border-color: rgba(201, 162, 75, 0.4);
  transform: translateY(-4px);
  box-shadow: 0 16px 40px rgba(0, 0, 0, 0.8);
}

.poster-top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.poster-code {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  font-weight: 700;
  color: var(--gold-champagne);
}

.poster-tag {
  font-family: var(--font-mono);
  font-size: 0.62rem;
  color: var(--muted);
  letter-spacing: 0.1em;
}

.poster-big-title {
  font-family: var(--font-heading);
  font-size: 1.4rem;
  font-weight: 800;
  color: #FFF;
  line-height: 1.15;
  margin: 1.2rem 0 0.8rem 0;
}

.poster-hover-desc {
  font-family: var(--font-body);
  font-size: 0.85rem;
  color: var(--text-secondary);
  line-height: 1.5;
}

.poster-footer-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 1.5rem;
  padding-top: 1rem;
  border-top: 1px solid rgba(255, 255, 255, 0.05);
}

.poster-start-price {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  color: var(--gold-light);
  font-weight: 600;
}

.poster-action-arrow {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  color: var(--muted);
  transition: color 0.2s ease, transform 0.2s ease;
}

.build-poster-card:hover .poster-action-arrow {
  color: var(--gold-champagne);
  transform: translateX(3px);
}

/* Process Path */
.process-path-container {
  position: relative;
  margin-top: 3rem;
  padding: 2rem 0;
}

.path-line-track {
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  height: 2px;
  background: rgba(255, 255, 255, 0.08);
  transform: translateY(-50%);
  z-index: 0;
}

.path-line-progress {
  height: 100%;
  width: 25%;
  background: linear-gradient(90deg, var(--gold-dark), var(--gold-champagne));
  transition: width 0.4s ease;
}

.process-steps-row {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 1rem;
  position: relative;
  z-index: 1;
}

.process-node-card {
  background: var(--surface);
  border: 1px solid rgba(255, 255, 255, 0.07);
  border-radius: 10px;
  padding: 1.2rem 1rem;
  cursor: pointer;
  transition: all 0.25s ease;
}

.process-node-card:hover, .process-node-card.active {
  background: var(--surface-hover);
  border-color: var(--gold-champagne);
  transform: translateY(-3px);
}

.p-step-num {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  font-weight: 700;
  color: var(--gold-champagne);
  display: block;
  margin-bottom: 0.3rem;
}

.p-step-title {
  font-family: var(--font-mono);
  font-size: 0.85rem;
  font-weight: 700;
  color: #FFF;
  margin-bottom: 0.4rem;
}

.p-step-desc {
  font-family: var(--font-body);
  font-size: 0.75rem;
  color: var(--text-secondary);
  line-height: 1.4;
}

/* AI Search Tab Strip & Inspector Panel */
.ai-tab-strip {
  display: flex;
  gap: 0.8rem;
  overflow-x: auto;
  padding-bottom: 0.8rem;
  margin: 2rem 0;
}

.ai-tab-btn {
  background: var(--surface);
  border: 1px solid rgba(255, 255, 255, 0.07);
  border-radius: 8px;
  padding: 0.85rem 1.4rem;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-width: 180px;
  transition: all 0.25s ease;
}

.ai-tab-btn span {
  font-family: var(--font-mono);
  font-size: 0.82rem;
  font-weight: 700;
  color: #FFF;
}

.ai-tab-btn small {
  font-family: var(--font-body);
  font-size: 0.72rem;
  color: var(--text-secondary);
  margin-top: 2px;
}

.ai-tab-btn:hover {
  background: var(--surface-hover);
  border-color: rgba(201, 162, 75, 0.3);
}

.ai-tab-btn.active {
  background: rgba(201, 162, 75, 0.12);
  border-color: var(--gold-champagne);
}

.ai-tab-btn.active span {
  color: var(--gold-light);
}

.ai-inspector-panel {
  background: var(--surface);
  border: 1px solid rgba(201, 162, 75, 0.25);
  border-radius: 12px;
  padding: 2.2rem;
}

.ai-panel-header {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 1rem;
}

.ai-panel-badge {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  font-weight: 700;
  color: var(--gold-champagne);
  background: rgba(201, 162, 75, 0.1);
  padding: 0.3rem 0.8rem;
  border-radius: 4px;
}

.ai-panel-acronym {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: var(--muted);
}

.ai-panel-title {
  font-family: var(--font-display);
  font-size: 2rem;
  font-weight: 700;
  color: #FFF;
  margin-bottom: 1.5rem;
}

.ai-panel-section {
  margin-bottom: 1.4rem;
}

.ai-panel-label {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  color: var(--gold-champagne);
  margin-bottom: 0.4rem;
}

.ai-panel-text {
  font-family: var(--font-body);
  font-size: 0.95rem;
  color: var(--text-secondary);
  line-height: 1.6;
}

.ai-panel-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.ai-panel-list li {
  font-family: var(--font-body);
  font-size: 0.9rem;
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  gap: 0.6rem;
}

.ai-panel-list li::before {
  content: '→';
  color: var(--gold-champagne);
  font-weight: 700;
}

/* Responsive Overrides */
@media (max-width: 1024px) {
  .hero-editorial {
    min-height: auto;
    padding: 3.25rem 1.5rem 2.5rem;
  }

  .hero-inner {
    grid-template-columns: 1fr;
    gap: 2.25rem;
    text-align: left;
  }

  .hero-content {
    align-items: flex-start;
    text-align: left;
  }

  .hero-sub-statement {
    margin-left: 0;
    margin-right: 0;
  }

  .hero-actions-group {
    justify-content: flex-start;
  }

  .hero-portrait-stage {
    justify-content: flex-start;
    margin-top: 0.25rem;
  }

  .portrait-wrapper {
    max-width: 400px;
  }

  .about-editorial-grid {
    grid-template-columns: 1fr;
  }
  .process-steps-row {
    grid-template-columns: repeat(2, 1fr);
  }
  .path-line-track {
    display: none;
  }
}

@media (max-width: 640px) {
  .hero-editorial {
    padding: 2.25rem 1.25rem 2.5rem;
  }

  .hero-dramatic-title {
    font-size: clamp(2.3rem, 10.5vw, 3.8rem);
    line-height: 0.96;
    margin-bottom: 1rem;
  }

  .hero-eyebrow-tag {
    font-size: 0.68rem;
    margin-bottom: 0.85rem;
  }

  .hero-sub-statement {
    font-size: 0.98rem;
    line-height: 1.55;
    margin-bottom: 1.75rem;
  }

  .hero-actions-group {
    flex-direction: column;
    align-items: stretch;
    width: 100%;
    gap: 0.8rem;
    margin-bottom: 1.8rem;
  }

  .hero-actions-group .btn-primary,
  .hero-actions-group .btn-ghost {
    width: 100%;
    justify-content: center;
    box-sizing: border-box;
    min-height: 48px;
    font-size: 0.88rem;
  }

  .portrait-wrapper {
    max-width: 100%;
    border-radius: 10px;
  }

  .hero-portrait-img {
    height: 100%;
    max-height: none;
  }

  .process-steps-row {
    grid-template-columns: 1fr;
  }
}

