/* ==========================================================================
   RESPONSIVE DESIGN SYSTEM (360px, 390px, 430px, 768px, 1024px, 1280px)
   NO OVERLAPPING • AIRY MARGINS • TOUCH-SAFE TARGETS
   ========================================================================== */
@media (max-width: 1024px) {
  #navbar {
    width: 100%;
    left: 0;
    right: 0;
    padding: 1.1rem 2rem;
    box-sizing: border-box;
  }
  .section-wrap { padding: 4.5rem 2rem; }
  .hero-inner { grid-template-columns: 1fr; gap: 3.5rem; }
  .hero-photo-container { order: -1; }
  .proof-strip-inner { grid-template-columns: repeat(2, 1fr); }
  .service-editorial-block,
  .service-editorial-block.reverse-layout {
    grid-template-columns: 1fr;
    gap: 2rem;
    padding: 2.5rem;
  }
  .industry-solutions-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }
  .services-preview-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }
  .about-grid { grid-template-columns: 1fr; }
  .about-photo-wrap { position: static; max-width: 440px; margin: 0 auto; }
  .tier-grid { grid-template-columns: 1fr; }
  .tier-card.featured-tier { transform: none; }
  .pricing-cards-grid { grid-template-columns: repeat(2, 1fr); }
  .contact-card { grid-template-columns: 1fr; padding: 2.5rem; }
  footer {
    width: 100%;
    padding: 3.5rem 2rem 2.25rem;
    box-sizing: border-box;
  }
  .footer-inner {
    width: 100%;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    box-sizing: border-box;
  }
}

@media (max-width: 768px) {
  :root {
    --header-height: 62px;
  }

  /* Full-width sticky mobile header (56–64px height) */
  #navbar {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    width: 100% !important;
    min-height: 60px;
    max-height: 64px;
    padding: 0.75rem 1.25rem;
    z-index: 950;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-sizing: border-box !important;
  }

  .nav-logo-group {
    max-width: calc(100% - 54px);
  }

  .nav-logo {
    font-size: 1.1rem;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .nav-tagline {
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Full-width dropdown navigation underneath header bar */
  .nav-links {
    display: flex !important;
    position: fixed;
    top: 62px;
    left: 0;
    right: 0;
    width: 100% !important;
    max-height: 0;
    opacity: 0;
    visibility: hidden;
    overflow: hidden;
    background: #FFFFFF;
    border-bottom: 2px solid var(--border-gold);
    padding: 0 1.25rem;
    flex-direction: column;
    align-items: stretch;
    gap: 0.9rem;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
    z-index: 940;
    box-sizing: border-box !important;
    transition: max-height 0.38s var(--ease-motion), opacity 0.3s var(--ease-motion), padding 0.35s var(--ease-motion), visibility 0.38s;
    pointer-events: none;
  }

  .nav-links.mobile-open {
    max-height: calc(100vh - 62px);
    opacity: 1;
    visibility: visible;
    overflow-y: auto;
    padding: 1.5rem 1.25rem 2.5rem;
    pointer-events: auto;
  }

  /* Staggered mobile nav links entrance (45-65ms intervals) */
  .nav-links li {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.28s var(--ease-motion), transform 0.28s var(--ease-motion);
  }

  .nav-links.mobile-open li {
    opacity: 1;
    transform: translateY(0);
  }

