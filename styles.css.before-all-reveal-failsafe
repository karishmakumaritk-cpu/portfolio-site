}

.project-card.medium-tall {
  grid-column: span 4;
}

.project-card.wide-landscape {
  grid-column: span 7;
}

.project-card.medium-standard {
  grid-column: span 5;
}

@media (hover: hover) and (pointer: fine) {
  .project-card:hover {
    border-color: transparent;
    transform: perspective(1000px) rotateX(0deg) translateY(-5px);
    box-shadow: 0 24px 56px rgba(0, 0, 0, 0.9), 0 0 32px rgba(201, 162, 75, 0.12);
  }

  .project-card:hover::before {
    opacity: 1;
    clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
  }

  .project-card:hover .project-img-cover {
    transform: scale(1.04); /* Exact 1.04 scale on hover */
