/* Mobile Motion Optimizations (Reduced Distance & Touch Safety) */
@media (max-width: 768px) {
  .reveal,
  [data-reveal],
  .reveal-card,
  .project-card.reveal,
  .pricing-card.reveal,
  .expertise-group.reveal,
  .service-editorial-block.reveal,
  .about-card.reveal,
  .contact-card.reveal {
    transform: translateY(18px) scale(1);
    transition-duration: 0.55s;
  }

  .reveal-heading,
  .section-title.reveal {
    transform: translateY(14px);
    transition-duration: 0.55s;
  }
}

/* Strict Reduced Motion Accessibility */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.001ms !important;
    scroll-behavior: auto !important;
  }

  .reveal,
  [data-reveal],
  .reveal-label,
  .reveal-heading,
  .reveal-sub,
  .reveal-card,
  .project-card.reveal,
  .pricing-card.reveal,
  .expertise-group.reveal,
  .service-editorial-block.reveal,
  .about-card.reveal,
  .contact-card.reveal,
  .custom-website-cta.reveal,
  .indian-biz-banner.reveal,
  .page-view-container *,
  .nav-links li,
  .scroll-progress-bar,
  .kai-chatbot-btn,
  .floating-whatsapp {
    opacity: 1 !important;
    transform: none !important;
    transition: none !important;
    animation: none !important;
  }
}

/* ==========================================================================
   IMAGE REVEAL, PARALLAX & HOVER ANIMATION SYSTEM
   ========================================================================== */
.img-reveal-wrap {
  position: relative;
  overflow: hidden;
}

.img-reveal-wrap img {
  opacity: 0;
  transform: scale(0.96) translateY(14px);
  transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  will-change: opacity, transform;
}

.img-reveal-wrap.is-revealed img,
.img-reveal-wrap img.is-revealed,
img.reveal-on-scroll.is-revealed {
  opacity: 1;
  transform: scale(1) translateY(0);
}

/* Hero photo breathing ambient glow */
@keyframes ambientGlowPulse {
  0%, 100% {
    transform: translate(-50%, -50%) scale(1);
    opacity: 0.7;
  }
  50% {
    transform: translate(-50%, -50%) scale(1.08);
    opacity: 0.95;
  }
}

.photo-glow-effect {
  animation: ambientGlowPulse 6s ease-in-out infinite;
}

/* Photo floating badges subtle parallax float */
@keyframes floatSubtle {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-5px); }
}

@keyframes floatSubtleLag {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(5px); }
}

.photo-floater.fl-top {
  animation: floatSubtle 5.5s ease-in-out infinite;
}

.photo-floater.fl-side {
  animation: floatSubtleLag 6.2s ease-in-out infinite 0.8s;
