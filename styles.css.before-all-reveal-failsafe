/* =========================================================
   KAI — FLOATING AI AGENT / ROBOT NODE
   ========================================================= */

.kai-chatbot-btn.kai-agent-trigger {
  position: fixed;
  right: 28px;
  bottom: 28px;
  z-index: 9998;

  width: 112px;
  height: 112px;
  padding: 0;
  border: 1px solid rgba(201,162,75,.42);
  border-radius: 50%;

  display: flex;
  align-items: center;
  justify-content: center;

  color: #fff;
  background:
    radial-gradient(circle at 50% 42%,
      rgba(201,162,75,.18) 0%,
      rgba(8,8,8,.96) 48%,
      #030303 100%);

  box-shadow:
    0 0 0 1px rgba(255,255,255,.035) inset,
    0 0 35px rgba(201,162,75,.14),
    0 18px 45px rgba(0,0,0,.55);

  cursor: pointer;
  overflow: visible;
  isolation: isolate;

  transition:
    transform .35s cubic-bezier(.16,1,.3,1),
    border-color .35s ease,
    box-shadow .35s ease;
}

.kai-chatbot-btn.kai-agent-trigger:hover {
  transform: translateY(-7px) scale(1.06);
  border-color: rgba(201,162,75,.9);
  box-shadow:
    0 0 0 1px rgba(201,162,75,.12) inset,
    0 0 55px rgba(201,162,75,.28),
    0 24px 55px rgba(0,0,0,.62);
}

/* Robot core */

.kai-agent-core {
  position: relative;
  width: 54px;
  height: 54px;
  border-radius: 18px;

  display: flex;
  align-items: center;
  justify-content: center;

  background:
    linear-gradient(145deg, #171717, #050505);

  border: 1px solid rgba(255,255,255,.14);

  box-shadow:
    0 0 0 5px rgba(201,162,75,.045),
    0 0 22px rgba(201,162,75,.22),
    inset 0 1px 0 rgba(255,255,255,.12);

  transform: translateZ(0);
  animation: kaiRobotFloat 4s ease-in-out infinite;
}

@keyframes kaiRobotFloat {
  0%,100% { transform: translateY(0) rotate(0deg); }
  50% { transform: translateY(-4px) rotate(.8deg); }
}

/* Robot face */

.kai-robot-face {
  position: relative;
  width: 34px;
  height: 27px;
  border: 1px solid rgba(201,162,75,.6);
  border-radius: 9px;
  background: #080808;
  box-shadow: 0 0 14px rgba(201,162,75,.12);
}

.kai-eye {
  position: absolute;
  top: 8px;
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: #C9A24B;
  box-shadow: 0 0 9px rgba(201,162,75,.9);
  animation: kaiEyePulse 2.4s ease-in-out infinite;
}

.kai-eye-left { left: 8px; }
.kai-eye-right { right: 8px; }

@keyframes kaiEyePulse {
  0%,85%,100% { transform: scaleY(1); opacity: 1; }
  90% { transform: scaleY(.15); opacity: .55; }
}

.kai-mouth {
  position: absolute;
  left: 50%;
  bottom: 5px;
  width: 9px;
  height: 2px;
  transform: translateX(-50%);
  border-radius: 4px;
  background: rgba(201,162,75,.7);
}

/* Orbit rings */

.kai-agent-orbit {
  position: absolute;
  inset: 8px;
  border: 1px solid rgba(201,162,75,.13);
  border-radius: 50%;
  pointer-events: none;
}

.kai-orbit-one {
  animation: kaiOrbitOne 8s linear infinite;
}

.kai-orbit-two {
  inset: 17px;
  border-color: rgba(255,255,255,.08);
  animation: kaiOrbitTwo 5s linear infinite reverse;
}

@keyframes kaiOrbitOne {
  to { transform: rotate(360deg); }
}

@keyframes kaiOrbitTwo {
  to { transform: rotate(360deg); }
}

/* Orbit signal dots */

.kai-agent-signal {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.kai-agent-signal span {
  position: absolute;
  width: 3px;
  height: 3px;
  border-radius: 50%;
  background: #C9A24B;
  box-shadow: 0 0 8px rgba(201,162,75,.8);
}

.kai-agent-signal span:nth-child(1) {
  top: 10px;
  left: 50%;
}

.kai-agent-signal span:nth-child(2) {
  right: 13px;
  top: 50%;
}

.kai-agent-signal span:nth-child(3) {
  bottom: 12px;
  left: 23%;
}

/* Agent label */

.kai-agent-label {
  position: absolute;
  right: -5px;
  top: 5px;

  display: flex;
  flex-direction: column;
  gap: 1px;

  padding: 5px 7px;
  border: 1px solid rgba(201,162,75,.25);
  border-radius: 7px;

  background: rgba(5,5,5,.88);
  backdrop-filter: blur(12px);

  text-align: left;
  line-height: 1;
  pointer-events: none;
}

.kai-agent-label strong {
  font-size: 9px;
  letter-spacing: .18em;
  color: #fff;
}

.kai-agent-label small {
  font-size: 5px;
  letter-spacing: .14em;
  color: rgba(201,162,75,.85);
}

/* ONLINE status */

.kai-agent-online {
  position: absolute;
  left: 50%;
  bottom: -8px;
  transform: translateX(-50%);

  display: flex;
  align-items: center;
  gap: 5px;

  padding: 4px 8px;
  border: 1px solid rgba(255,255,255,.09);
  border-radius: 999px;

  background: rgba(4,4,4,.9);
  backdrop-filter: blur(10px);

  font-size: 6px;
  font-weight: 800;
  letter-spacing: .18em;
  color: rgba(255,255,255,.48);
  white-space: nowrap;
  pointer-events: none;
}

.kai-agent-online .kai-btn-pulse {
  width: 5px !important;
  height: 5px !important;
  min-width: 5px;
  border-radius: 50%;
  background: #C9A24B;
  box-shadow: 0 0 8px rgba(201,162,75,.8);
}

/* Hide old trigger-only icon/text behavior */

.kai-agent-trigger > svg,
.kai-agent-trigger > span:not(.kai-agent-orbit):not(.kai-agent-core):not(.kai-agent-signal):not(.kai-agent-label):not(.kai-agent-online) {
  display: none;
}

@media (max-width: 600px) {
  .kai-chatbot-btn.kai-agent-trigger {
    right: 16px;
    bottom: 16px;
    width: 88px;
    height: 88px;
  }

  .kai-agent-core {
    width: 44px;
    height: 44px;
  }

  .kai-robot-face {
    transform: scale(.82);
  }

  .kai-agent-label {
    right: -8px;
  }
}

