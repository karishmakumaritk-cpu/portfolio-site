/* ==========================================================================
   PREMIUM MOTION & SCROLL REVEAL SYSTEM
   Unified Easing: cubic-bezier(0.22, 1, 0.36, 1)
   ========================================================================== */

/* Universal Scroll Reveal Elements */
.reveal,
[data-reveal] {
  opacity: 1;
  transform: translateY(0);
  transition: opacity 0.72s var(--ease-motion), transform 0.72s var(--ease-motion);
  will-change: opacity, transform;
}

.reveal.is-revealed,
[data-reveal].is-revealed {
  opacity: 1;
  transform: translateY(0);
}

/* Subtle Label Reveal (Section Eyebrow, Svc Tag) */
.reveal-label,
.section-eyebrow.reveal,
.proof-strip-tag.reveal,
.svc-num-tag.reveal {
  opacity: 1;
  transform: translateY(0);
  letter-spacing: 0.16em;
  transition: opacity 0.6s var(--ease-motion), transform 0.6s var(--ease-motion), letter-spacing 0.6s var(--ease-motion);
}

.reveal-label.is-revealed,
.section-eyebrow.reveal.is-revealed,
.proof-strip-tag.reveal.is-revealed,
.svc-num-tag.reveal.is-revealed {
  opacity: 1;
  transform: translateY(0);
  letter-spacing: 0.12em;
}

/* Headline Reveal */
.reveal-heading,
.section-title.reveal {
  opacity: 1;
  transform: translateY(0);
  transition: opacity 0.75s var(--ease-motion) 70ms, transform 0.75s var(--ease-motion) 70ms;
}

.reveal-heading.is-revealed,
.section-title.reveal.is-revealed {
  opacity: 1;
  transform: translateY(0);
}

/* Subtitle / Description Text Reveal */
.reveal-sub,
.section-sub.reveal {
  opacity: 1;
  transform: translateY(0);
  transition: opacity 0.75s var(--ease-motion) 140ms, transform 0.75s var(--ease-motion) 140ms;
}

.reveal-sub.is-revealed,
.section-sub.reveal.is-revealed {
  opacity: 1;
  transform: translateY(0);
}

/* Card & Block Reveal */
.reveal-card,
.project-card.reveal,
.pricing-card.reveal,
.expertise-group.reveal,
.service-editorial-block.reveal,
.about-card.reveal,
.contact-card.reveal {
  opacity: 1;
  transform: translateY(0) scale(1);
  transition: opacity 0.75s var(--ease-motion), transform 0.75s var(--ease-motion), border-color 0.3s ease, box-shadow 0.4s var(--ease-motion);
  will-change: opacity, transform;
}

.reveal-card.is-revealed,
.project-card.reveal.is-revealed,
.pricing-card.reveal.is-revealed,
.expertise-group.reveal.is-revealed,
.service-editorial-block.reveal.is-revealed,
.about-card.reveal.is-revealed,
.contact-card.reveal.is-revealed {
  opacity: 1;
  transform: translateY(0) scale(1);
}

/* Wide Banners & CTA Boxes Reveal */
.custom-website-cta.reveal,
.indian-biz-banner.reveal {
  opacity: 1;
  transform: translateY(0);
  transition: opacity 0.75s var(--ease-motion), transform 0.75s var(--ease-motion);
}

.custom-website-cta.reveal.is-revealed,
.indian-biz-banner.reveal.is-revealed {
  opacity: 1;
  transform: translateY(0);
}

/* Systematic Stagger Delays (0ms–420ms) */
.stagger-1 { transition-delay: 70ms !important; }
.stagger-2 { transition-delay: 140ms !important; }
.stagger-3 { transition-delay: 210ms !important; }
.stagger-4 { transition-delay: 280ms !important; }
.stagger-5 { transition-delay: 350ms !important; }
.stagger-6 { transition-delay: 420ms !important; }

/* Footer Reveal & Links Micro-Interaction */
footer .footer-col.reveal,
footer .footer-links-col.reveal {
  opacity: 0;
  transform: translateY(20px);
  transition: opacity 0.7s var(--ease-motion), transform 0.7s var(--ease-motion);
}

footer .footer-col.reveal.is-revealed,
footer .footer-links-col.reveal.is-revealed {
  opacity: 1;
  transform: translateY(0);
}

footer .footer-bottom.reveal {
  opacity: 0;
  transform: translateY(14px);
  transition: opacity 0.7s var(--ease-motion) 280ms, transform 0.7s var(--ease-motion) 280ms;
}

footer .footer-bottom.reveal.is-revealed {
  opacity: 1;
  transform: translateY(0);
}

.footer-links-list li a {
  display: inline-block;
  transition: transform 0.25s var(--ease-motion), color 0.2s ease;
}

.footer-links-list li a:hover {
  color: var(--terracotta);
  transform: translateX(4px);
}

/* Floating Actions Hover & Tap Responses */
.floating-whatsapp {
