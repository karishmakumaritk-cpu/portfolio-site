/* ==========================================================================
   CINEMATIC HORIZONTAL & VERTICAL ENGINEERING TIMELINE
   ========================================================================== */
.engineering-timeline-container {
  position: relative;
  margin-top: 3.5rem;
  width: 100%;
}

.timeline-laser-track {
  position: absolute;
  top: 24px;
  left: 3%;
  right: 3%;
  height: 2px;
  z-index: 1;
  pointer-events: none;
}

.timeline-laser-base {
  position: absolute;
  inset: 0;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 999px;
}

.timeline-laser-progress {
  position: absolute;
  top: 0;
  left: 0;
  bottom: 0;
  width: 20%;
  background: linear-gradient(90deg, #B49A67, #E4C77A, #FFFFFF);
  border-radius: 999px;
  box-shadow: 0 0 12px rgba(228, 199, 122, 0.7);
  transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1), height 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.timeline-steps-track {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 1.25rem;
  position: relative;
  z-index: 2;
}

.timeline-step-node {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
  cursor: pointer;
  transition: opacity 0.4s ease, transform 0.4s ease;
}

.timeline-node-pin {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: #141210;
  border: 1px solid rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  margin: 0 auto;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.timeline-node-pin .node-step-num {
  font-family: var(--font-ui);
  font-size: 0.75rem;
  font-weight: 800;
  letter-spacing: 0.05em;
  color: #A5A29A;
  transition: color 0.3s ease;
}

.timeline-node-pin .node-core {
  position: absolute;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #E4C77A;
  opacity: 0;
  transform: scale(0.5);
  transition: all 0.3s ease;
}

.timeline-node-pin .node-ring {
  position: absolute;
  inset: -4px;
  border-radius: 50%;
  border: 1px solid #E4C77A;
  opacity: 0;
  transform: scale(0.8);
  transition: all 0.3s ease;
}

.timeline-step-node:hover .timeline-node-pin,
.timeline-step-node.active-step .timeline-node-pin {
  border-color: #E4C77A;
  background: #1B1917;
  box-shadow: 0 0 20px rgba(228, 199, 122, 0.35);
}

.timeline-step-node:hover .node-step-num,
.timeline-step-node.active-step .node-step-num {
  color: #FFFFFF;
}

.timeline-step-node.active-step .node-ring {
  opacity: 1;
  transform: scale(1);
}

.timeline-step-card {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 14px;
  padding: 1.5rem 1.25rem;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 220px;
  transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}

.timeline-step-node:hover .timeline-step-card,
.timeline-step-node.active-step .timeline-step-card {
  background: rgba(180, 154, 103, 0.08);
  border-color: rgba(228, 199, 122, 0.45);
  transform: translateY(-4px);
  box-shadow: 0 14px 35px rgba(0, 0, 0, 0.4);
}

.step-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 0.8rem;
}

.step-code {
  font-family: var(--font-ui);
  font-size: 0.65rem;
  font-weight: 800;
  letter-spacing: 0.1em;
  color: #E4C77A;
}

.step-duration {
  font-family: var(--font-ui);
  font-size: 0.62rem;
  font-weight: 700;
  color: #A5A29A;
  background: rgba(255, 255, 255, 0.06);
  padding: 0.2rem 0.5rem;
  border-radius: 4px;
}

.timeline-step-title {
  font-family: var(--font-heading);
  font-size: 1.05rem;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 0.6rem;
  letter-spacing: -0.01em;
}

.timeline-step-desc {
