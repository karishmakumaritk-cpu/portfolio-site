.sticker-element.float-1 {
  animation: stickerFloat1 6s ease-in-out infinite alternate;
}

.sticker-element.float-2 {
  animation: stickerFloat2 7.5s ease-in-out infinite alternate;
}

.sticker-element.float-3 {
  animation: stickerFloat3 5.5s ease-in-out infinite alternate;
}

@keyframes stickerFloat1 {
  0% { transform: translateY(0px) rotate(0deg); }
  100% { transform: translateY(-7px) rotate(1.2deg); }
}

@keyframes stickerFloat2 {
  0% { transform: translateY(0px) rotate(0deg); }
  100% { transform: translateY(-9px) rotate(-1.5deg); }
}

@keyframes stickerFloat3 {
  0% { transform: translateY(0px); }
  100% { transform: translateY(-6px); }
