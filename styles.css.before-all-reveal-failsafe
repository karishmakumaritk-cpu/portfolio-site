  border-radius: 50%;
  background: radial-gradient(circle, rgba(212, 175, 55, 0.35) 0%, rgba(184, 134, 11, 0.12) 45%, rgba(0, 0, 0, 0) 70%);
  filter: blur(120px);
  opacity: 0.45;
  pointer-events: none;
  z-index: 0;
  will-change: transform;
  transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}

.hero-inner {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 1240px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: minmax(0, 1.1fr) minmax(360px, 0.9fr);
  align-items: center;
  gap: 3.5rem;
  box-sizing: border-box;
}

.hero-content {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  width: 100%;
  max-width: 100%;
  text-align: left;
  will-change: transform;
  transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}

.hero-eyebrow-tag {
  display: inline-flex;
  align-items: center;
  gap: 0.75rem;
  font-family: var(--font-mono);
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.25em;
  color: var(--gold-champagne);
  text-transform: uppercase;
  margin-bottom: 1.25rem;
}

.eyebrow-gold-line {
  display: inline-block;
  height: 1px;
  width: 40px;
  background: linear-gradient(to right, var(--gold-champagne), transparent);
}

.hero-dramatic-title {
  font-family: var(--font-heading);
  font-size: clamp(3rem, 4.5vw, 5.2rem);
  font-weight: 800;
  letter-spacing: -0.045em;
  line-height: 0.91;
  color: #FFFFFF;
  margin-bottom: 1.5rem;
  text-transform: uppercase;
  max-width: 100%;
  overflow-wrap: normal;
  word-break: normal;
  text-wrap: balance;
}

.hero-dramatic-title .title-line {
  display: block;
}

.hero-dramatic-title .title-accent {
  background: linear-gradient(90deg, #FFFFFF 0%, #F3E5AB 50%, #D4AF37 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  font-family: var(--font-display);
  font-style: italic;
  font-weight: 700;
}

.hero-sub-statement {
  font-family: var(--font-body);
  font-size: clamp(1.05rem, 1.4vw, 1.25rem);
  color: #9CA3AF;
  font-weight: 300;
  line-height: 1.65;
  max-width: 520px;
  margin-bottom: 2.25rem;
}

.hero-actions-group {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  flex-wrap: wrap;
  width: 100%;
  max-width: 100%;
}

.hero-btn-main {
  position: relative;
  overflow: hidden;
  padding: 0.85rem 1.8rem;
  border: 1px solid rgba(212, 175, 55, 0.5);
  border-radius: 9999px;
  font-size: 0.82rem;
  font-weight: 600;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--gold-champagne);
  background: transparent;
  transition: color 0.5s ease;
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  text-decoration: none;
}

.hero-btn-main::before {
  content: '';
  position: absolute;
  inset: 0;
  background: #D4AF37;
  transform: translateY(100%);
  transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  z-index: 0;
}

.hero-btn-main:hover::before {
  transform: translateY(0);
}

.hero-btn-main:hover {
  color: #000000;
}

.hero-btn-main > * {
  position: relative;
  z-index: 10;
}

.hero-status-pill {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-family: var(--font-mono);
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: #737373;
}

.status-pulse-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background-color: #D4AF37;
  box-shadow: 0 0 10px rgba(212, 175, 55, 0.8);
  animation: pulseDot 2s infinite ease-in-out;
}

@keyframes pulseDot {
  0%, 100% { opacity: 0.4; transform: scale(0.9); }
  50% { opacity: 1; transform: scale(1.3); }
}

/* Portrait Stage & Catwalk Motion */
.hero-portrait-stage {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: flex-end;
  width: 100%;
  max-width: 100%;
}

.portrait-wrapper {
  position: relative;
  width: min(100%, 500px);
  height: min(78vh, 700px);
  min-height: 560px;
  flex: 0 1 500px;
  overflow: visible;
  border-radius: 0;
  border: 0;
  box-shadow: none;
  background: transparent;
  isolation: isolate;
  will-change: transform;
  transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}

.hero-portrait-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  max-height: none;
  display: block;
  object-fit: contain;
  object-position: center bottom;
  filter: drop-shadow(0 28px 45px rgba(0, 0, 0, 0.55));
  will-change: transform;
}

@keyframes catwalkIdleMotion {
  0% {
    transform: translateY(0px) translateX(0px) rotate(0deg);
  }
  25% {
    transform: translateY(-6px) translateX(2px) rotate(0.3deg);
  }
  50% {
    transform: translateY(0px) translateX(-2px) rotate(-0.3deg);
  }
  75% {
    transform: translateY(-4px) translateX(1px) rotate(0deg);
  }
  100% {
    transform: translateY(0px) translateX(0px) rotate(0deg);
  }
}

.portrait-blend-gradient {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 160px;
  background: linear-gradient(to top, #0A0A0A 15%, rgba(10, 10, 10, 0.6) 60%, transparent 100%);
  pointer-events: none;
  z-index: 20;
}

.portrait-blend-gradient {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 110px;
  background: linear-gradient(to top, rgba(10, 10, 10, 0.55), transparent);
  pointer-events: none;
  z-index: 20;
}

.portrait-corner-frame .p-corner {
  position: absolute;
  width: 14px;
  height: 14px;
  border-color: var(--gold-champagne);
  border-style: solid;
  pointer-events: none;
}
.portrait-corner-frame .top-left { top: 12px; left: 12px; border-width: 2px 0 0 2px; }
.portrait-corner-frame .top-right { top: 12px; right: 12px; border-width: 2px 2px 0 0; }
.portrait-corner-frame .bottom-left { bottom: 12px; left: 12px; border-width: 0 0 2px 2px; }
.portrait-corner-frame .bottom-right { bottom: 12px; right: 12px; border-width: 0 2px 2px 0; }


.ticker-track {
  display: inline-flex;
  align-items: center;
  gap: 1.5rem;
  animation: tickerScroll 32s linear infinite;
}

@keyframes tickerScroll {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}

.ticker-item {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.12em;
  color: var(--text-secondary);
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
}

.ticker-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #22c55e;
}

.ticker-sep {
  color: rgba(201, 162, 75, 0.4);
}

/* About Editorial Section */
.about-editorial-grid {
