}

.methodology-step-title {
  font-family: var(--font-ui);
  font-size: 0.92rem;
  font-weight: 700;
  color: var(--charcoal);
  margin-bottom: 0.35rem;
}

.methodology-step-desc {
  font-size: 0.88rem;
  line-height: 1.6;
  color: var(--muted);
  margin: 0;
}


