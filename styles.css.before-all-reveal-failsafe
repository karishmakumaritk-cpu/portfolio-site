  cursor: pointer;
  position: relative;
  /* Work Archive: cards enter with a slight skew-correct (rotateX(4deg) + translateY, settle flat) */
  opacity: 0;
  transform: perspective(1000px) rotateX(4deg) translateY(32px);
  transition: transform 0.75s var(--ease-motion), opacity 0.75s var(--ease-motion), border-color 0.3s ease, box-shadow 0.4s var(--ease-motion);
  will-change: transform, opacity;
}

.project-card.in-view {
  opacity: 1;
  transform: perspective(1000px) rotateX(0deg) translateY(0);
}

/* Gold border draws in on hover via animated border clip-path */
.project-card::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 6px;
  border: 1.5px solid var(--gold);
  pointer-events: none;
  opacity: 0;
  clip-path: polygon(0 0, 0 0, 0 100%, 0 100%);
  transition: clip-path 0.5s var(--ease-motion), opacity 0.3s ease;
  z-index: 6;
}

.project-card.featured-wide {
