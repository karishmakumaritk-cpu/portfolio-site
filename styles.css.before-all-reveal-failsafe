}

.ai-card-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-family: var(--font-ui);
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  color: var(--terracotta);
  background: transparent;
  border: 1px solid var(--border-terracotta);
  border-radius: 8px;
  padding: 0.65rem 1.1rem;
  cursor: pointer;
  transition: all 0.2s ease;
  width: 100%;
  justify-content: center;
}

.ai-card-btn:hover {
  background: var(--terracotta);
  color: #FFFFFF;
}

/* ==========================================================================
   FAQ SECTION (AEO IN PRACTICE)
   ========================================================================== */
.faq-wrap {
  max-width: 960px;
  margin: 0 auto;
}

.faq-accordion {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  margin-top: 2rem;
}

.faq-item {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 8px;
  overflow: hidden;
  position: relative;
  transition: border-color 0.25s ease, box-shadow 0.25s ease;
}

/* FAQ underline rule draws on scroll into view */
.faq-item::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 0%;
  height: 1.5px;
  background: linear-gradient(90deg, var(--gold-bright) 0%, var(--gold) 60%, transparent 100%);
  transition: width 0.85s cubic-bezier(0.16, 1, 0.3, 1);
  pointer-events: none;
}

.faq-item.in-view::after {
  width: 100%;
}

.faq-item[open] {
  border-color: var(--border-gold);
  box-shadow: 0 10px 28px rgba(0, 0, 0, 0.7), 0 0 16px rgba(201, 162, 75, 0.1);
}

.faq-question {
  padding: 1.35rem 1.75rem;
  font-family: var(--font-ui);
  font-size: 1.05rem;
  font-weight: 600;
  color: var(--text-primary);
  cursor: pointer;
  list-style: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  user-select: none;
}

.faq-question::-webkit-details-marker {
  display: none;
}

.faq-question:focus-visible {
  outline: 2px solid var(--gold);
  outline-offset: -2px;
}

.faq-icon {
  width: 20px;
  height: 20px;
  stroke: var(--gold);
  transition: transform 0.25s ease;
  flex-shrink: 0;
}

.faq-item[open] .faq-icon {
  transform: rotate(180deg);
}

.faq-answer {
  padding: 0 1.75rem 1.5rem 1.75rem;
  font-size: 0.95rem;
  line-height: 1.75;
  color: var(--muted);
  border-top: 1px solid rgba(27, 25, 23, 0.05);
  margin-top: 0.25rem;
  padding-top: 1.1rem;
}

.faq-answer p {
  margin-bottom: 0.75rem;
}

.faq-answer p:last-child {
  margin-bottom: 0;
}

.faq-answer strong {
  color: var(--charcoal);
  font-weight: 600;
}

/* Method Modal Specifics */
.methodology-modal-body {
  padding: 0.5rem 0;
}

.methodology-tag {
  display: inline-block;
  font-family: var(--font-ui);
  font-size: 0.75rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  color: var(--terracotta);
  background: var(--terracotta-glow);
  padding: 0.35rem 0.85rem;
  border-radius: 999px;
  margin-bottom: 0.85rem;
}

.methodology-title {
  font-family: var(--font-display);
  font-size: 1.85rem;
  color: var(--charcoal);
  margin-bottom: 0.85rem;
}

.methodology-step {
  margin-bottom: 1.4rem;
  padding: 1.1rem 1.35rem;
  background: var(--surface2);
  border-left: 3px solid var(--terracotta);
