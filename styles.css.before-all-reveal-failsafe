   AI SEARCH & VISIBILITY (AEO, GEO, LLMO, AISO, E-E-A-T) SECTION
   ========================================================================== */
.ai-visibility-intro {
  margin-bottom: 3.5rem;
}

.ai-cards-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.75rem;
  margin-bottom: 2.5rem;
}

@media (max-width: 1024px) {
  .ai-cards-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 640px) {
  .ai-cards-grid {
    grid-template-columns: 1fr;
  }
}

.ai-search-central-node {
  display: inline-flex;
  align-items: center;
  gap: 0.65rem;
  padding: 0.45rem 1.1rem;
  background: rgba(11, 11, 11, 0.92);
  border: 1px solid var(--border-gold);
  border-radius: 999px;
  font-family: var(--font-mono);
  font-size: 0.72rem;
  letter-spacing: 0.12em;
  color: var(--gold-bright);
  margin-top: 1.25rem;
  opacity: 0;
  transform: scale(0.92);
  transition: opacity 0.65s var(--ease-motion), transform 0.65s var(--ease-motion);
}

.ai-search-central-node.in-view {
  opacity: 1;
  transform: scale(1);
}

.ai-search-center-pulse {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--gold);
  box-shadow: 0 0 8px var(--gold);
  animation: goldDotPulse 2.4s infinite ease-in-out;
}

@keyframes goldDotPulse {
  0%, 100% { transform: scale(1); opacity: 0.8; }
  50% { transform: scale(1.4); opacity: 1; box-shadow: 0 0 14px var(--gold-bright); }
}

.ai-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 2.2rem 1.85rem;
  display: flex;
  flex-direction: column;
  position: relative;
  box-shadow: var(--shadow-sm);
  /* AI Search: nodes fade/scale in radiating outward */
  opacity: 0;
  transform: scale(0.92) translateY(24px);
  transition: transform 0.75s var(--ease-motion), 
              opacity 0.75s var(--ease-motion),
              box-shadow 0.4s var(--ease-motion),
              border-color 0.3s ease;
  will-change: transform, opacity;
}

.ai-card:nth-child(1) { transition-delay: 0.15s; }
.ai-card:nth-child(2) { transition-delay: 0.28s; }
.ai-card:nth-child(3) { transition-delay: 0.41s; }
.ai-card:nth-child(4) { transition-delay: 0.54s; }
.ai-card:nth-child(5) { transition-delay: 0.67s; }

.ai-card.in-view {
  opacity: 1;
  transform: scale(1) translateY(0);
}

.ai-card:hover {
  transform: scale(1) translateY(-4px);
  border-color: var(--border-gold);
  box-shadow: 0 16px 40px rgba(0, 0, 0, 0.8), 0 0 20px rgba(201, 162, 75, 0.12);
}

.ai-card.highlight-card {
  border-color: var(--gold);
  background: linear-gradient(180deg, var(--surface) 0%, var(--surface2) 100%);
}

/* Selected node soft gold glow pulse (subtle, no neon) */
.ai-card.selected-pulse,
.ai-card.highlight-card.in-view {
  animation: softGoldGlowPulse 3.6s ease-in-out infinite;
}

@keyframes softGoldGlowPulse {
  0%, 100% {
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.6), 0 0 14px rgba(201, 162, 75, 0.12);
    border-color: rgba(201, 162, 75, 0.4);
  }
  50% {
    box-shadow: 0 10px 32px rgba(0, 0, 0, 0.85), 0 0 26px rgba(201, 162, 75, 0.26);
    border-color: var(--gold-bright);
  }
}

.ai-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 1.1rem;
}

.ai-card-badge {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--gold-bright);
  background: rgba(201, 162, 75, 0.1);
  border: 1px solid rgba(201, 162, 75, 0.25);
  padding: 0.35rem 0.75rem;
  border-radius: 999px;
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
}

.ai-card-badge.gold {
  color: var(--gold-bright);
  background: rgba(201, 162, 75, 0.18);
  border-color: var(--gold);
}

.ai-card-acronym {
  font-family: var(--font-heading);
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--muted2);
  letter-spacing: 0.05em;
}

.ai-card-title {
  font-family: var(--font-display);
  font-size: 1.45rem;
  color: var(--charcoal);
  line-height: 1.25;
  margin-bottom: 0.85rem;
  letter-spacing: -0.015em;
}

.ai-card-def {
  font-size: 0.92rem;
  line-height: 1.65;
  color: var(--charcoal-soft);
  margin-bottom: 1rem;
}

.ai-card-def strong,
.ai-card-purpose strong,
.ai-card-how strong,
.ai-card-example strong {
  color: var(--charcoal);
  font-weight: 600;
  display: inline-block;
}

.ai-card-purpose {
  font-size: 0.88rem;
  line-height: 1.6;
  color: var(--muted);
  margin-bottom: 1.1rem;
  padding-left: 0.85rem;
  border-left: 2px solid var(--gold);
}

.ai-card-how {
  font-size: 0.86rem;
  line-height: 1.55;
  color: var(--muted);
  margin-bottom: 1rem;
}

.ai-card-how ul {
  list-style: none;
  padding: 0;
  margin: 0.45rem 0 0 0;
}

.ai-card-how li {
  position: relative;
  padding-left: 1.15rem;
  margin-bottom: 0.35rem;
}

.ai-card-how li::before {
  content: '→';
  position: absolute;
  left: 0;
